{
  "name": "dinner-api",
  "version": "0.1.0",
  "private": true,
  "description": "오늘 저녁 뭐 먹지 — Cloudflare Workers 중계 서버",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply dinner-cache --local",
    "db:migrate:remote": "wrangler d1 migrations apply dinner-cache --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261119.1",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "wrangler": "^4.165.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
